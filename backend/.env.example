# OpenAI API key used for chat completions and embeddings.
# In production this is replaced by Azure OpenAI (endpoint + key/managed identity) — see README.
OPENAI_API_KEY=sk-...

# Model names — override to use different OpenAI models.
CHANGEPILOT_CHAT_MODEL=gpt-4o-mini
CHANGEPILOT_EMBEDDING_MODEL=text-embedding-3-small

# Local storage locations (swap for SQL Server / Azure AI Search in production).
CHANGEPILOT_DB_PATH=./changepilot.db
CHANGEPILOT_CHROMA_PATH=./chroma_store
CHANGEPILOT_SAMPLE_APP_PATH=../sample-app
